# 数据库
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE_LIBRARY=library_db
MYSQL_DATABASE_STUDENT=student_db

# JWT
JWT_SECRET_LIBRARY=your_jwt_secret_at_least_256_bits_for_library_change_me
JWT_SECRET_STUDENT=your_jwt_secret_at_least_256_bits_for_student_change_me

# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your_key_here
DASHSCOPE_MODEL=qwen-plus

# 服务端口
LIBRARY_PORT=8080
STUDENT_PORT=8081
AI_GATEWAY_PORT=8082
PORTAL_PORT=8083
